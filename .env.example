# Скопируйте в .env.local и заполните нужные значения.
# Anon key Supabase публичен: доступ ограничен RLS-политиками (см. supabase/schema.sql).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Необязательно: GoatCounter для внешней аналитики.
VITE_GOATCOUNTER=

# Необязательно: переопределение Giscus (по умолчанию уже прописан репозиторий архива).
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY_ID=
